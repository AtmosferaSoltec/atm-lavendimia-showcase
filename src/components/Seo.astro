---
import { site } from "../data/site";
const logos = import.meta.glob<{ default: { src: string } }>(
  "../assets/brand/*.svg",
  { eager: true },
);
const logo = logos[site.logo].default.src;
const title = `${site.name} · ${site.tagline}`;
const og = new URL("/og.jpg", site.url).href;
const schema = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: site.name,
  url: site.url,
  telephone: site.phoneDisplay,
  image: og,
  logo: new URL(logo, site.url).href,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address[0],
    addressLocality: "Ica",
    addressCountry: "PE",
  },
};
---

<title>{title}</title>
<meta name="description" content={site.description} />
<link rel="canonical" href={site.url} />
{!site.indexable && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_PE" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={site.description} />
<meta property="og:url" content={site.url} />
<meta property="og:image" content={og} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="La Vendimia · El gusto de compartir" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={site.description} />
<meta name="twitter:image" content={og} />
<script
  type="application/ld+json"
  set:html={JSON.stringify(schema).replace(/</g, "\u003c")}
/>
