---
import Brand from "./Brand.astro";
import WhatsAppLink from "./WhatsAppLink.astro";
import { site, copy } from "../data/site";
---

<div class="announcement">
  <div class="container">
    <span>{copy.announcement}</span>
    <span>{site.shipping} ↗</span>
  </div>
</div>
<header>
  <div class="container header-inner">
    <Brand />
    <button
      class="cart-toggle js-only"
      type="button"
      aria-haspopup="dialog"
      aria-controls="cart-dialog"
      aria-label={copy.ui.verMiPedido}
    >
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M5 8h14l-1 12H6L5 8Z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" />
      </svg>
      <span class="cart-count" hidden>0</span>
    </button>
    <button
      class="menu-toggle js-only"
      aria-expanded="false"
      aria-controls="navigation"
      aria-label={copy.ui.abrirMenu}
    >
      ☰
    </button>
    <nav id="navigation" aria-label={copy.ui.navegacionPrincipal}>
      <a href="#coleccion">{copy.ui.laColeccion}</a>
      <a href="#esencia">{copy.ui.nuestraEsencia}</a>
      <a href="#momentos">{copy.ui.paraCadaMomento}</a>
      <WhatsAppLink class="button outline">{copy.ui.escribenos}</WhatsAppLink>
    </nav>
  </div>
</header>
<script>
  import "../scripts/menu";
</script>
