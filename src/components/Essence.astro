---
import BrandArt from "./BrandArt.astro";
import WhatsAppLink from "./WhatsAppLink.astro";
import { site, copy } from "../data/site";
---

<section id="esencia" class="essence reveal" aria-labelledby="essence-title">
  <BrandArt class="essence-image" />
  <div class="essence-copy">
    <p class="eyebrow">{copy.ui.seccion02NuestraEsencia}</p>
    <h2 id="essence-title">
      {copy.ui.masQueUnaCopa}
      <br />
      <em>{copy.ui.loQueCompartimos}</em>
    </h2>
    {copy.essence.map((p) => (
      <p>{p}</p>
    ))}
    <WhatsAppLink class="text-link">
      {copy.ui.nosEncantaraConocerte}
    </WhatsAppLink>
    <p class="signature">
      {site.name}
      <span>{site.tagline}.</span>
    </p>
  </div>
</section>
