---
import { getCollection } from "astro:content";
import ProductCard from "./ProductCard.astro";
import ProductDialog from "./ProductDialog.astro";
import { categories, copy } from "../data/site";
const products = (await getCollection("catalog")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section
  id="catalogo"
  class="container section catalog"
  aria-labelledby="catalog-title"
>
  <p class="eyebrow">{copy.ui.eligeDescubreDisfruta}</p>
  <div class="section-heading">
    <h2 id="catalog-title">
      {copy.ui.tuProxima}
      <em>{copy.ui.buenaCopa}</em>
    </h2>
    <p>{copy.ui.aTuGustoATuMedida}</p>
  </div>
  <div class="catalog-controls js-only">
    <div class="filters" role="group" aria-label={copy.ui.filtrarPorCategoria}>
      <button data-filter="all" aria-pressed="true">
        {copy.ui.todaLaColeccion}
      </button>
      {Object.entries(categories).map(([key, c]) => (
        <button data-filter={key} aria-pressed="false">
          {c.label}
        </button>
      ))}
    </div>
    <label class="search">
      <span class="sr-only">{copy.ui.buscarEnElCatalogo}</span>
      <svg
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <circle cx="10" cy="10" r="6" />
        <path d="m15 15 5 5" />
      </svg>
      <input type="search" placeholder={copy.ui.queTeProvoca} id="search" />
    </label>
  </div>
  <div class="catalog-meta">
    <p id="results" aria-live="polite" aria-atomic="true">
      {products.length} sabores por descubrir
    </p>
    <p>{copy.ui.consultaPresentacionesYPreciosPorWhatsapp}</p>
  </div>
  <div class="product-grid">
    {products.map((product) => (
      <ProductCard product={product} />
    ))}
  </div>
  <div id="empty" hidden>
    <h3>{copy.ui.tuFavoritoPuedeEstarAUna}</h3>
    <button class="button outline" id="clear-filters">
      {copy.ui.limpiarFiltros}
    </button>
  </div>
  <div class="load-more js-only">
    <button id="more" class="button outline">
      {copy.ui.verMas}
      <span aria-hidden="true">+</span>
    </button>
    <p id="shown"></p>
  </div>
</section>
<ProductDialog />
<script>
  import "../scripts/catalog";
</script>
