---
import Photo from "./Photo.astro";
import {
  categories,
  site,
  productTitle,
  capacityValue,
  whatsappUrl,
  productMessage,
  copy,
  formatPrice,
} from "../data/site";
const { product } = Astro.props;
const p = product.data;
const variants = [...p.variants].sort(
  (a, b) => capacityValue(a.capacity) - capacityValue(b.capacity),
);
const prices = site.showPrices
  ? variants.flatMap((v) => (v.price === undefined ? [] : [v.price]))
  : [];
const src = p.image;
const reference = p.imageIsReference
    ? "Recreación de estudio del producto"
    : "";
---

<article
  class="product-card reveal"
  data-product
  data-id={p.id}
  data-category={p.category}
  data-name={p.name}
  data-variants={JSON.stringify(variants.map(({ price, ...variant }) => site.showPrices ? { ...variant, price } : variant))}
  data-phrase={categories[p.category].phrase}
>
  <a
    class="product-open"
    href={whatsappUrl(productMessage(p.name, variants[0]))}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${categories[p.category].label}. ${reference}. ${productTitle(p.name)}. ${[...new Set(variants.map((v) => v.capacity ?? "Por confirmar"))].slice(0, 3).join(" / ")}. Descubrir. Consultar ${p.name} por WhatsApp`}
  >
    <div class="product-image studio">
      <Photo
          src={src}
          kind="product"
          alt={reference ? `${p.name}: ${reference.toLowerCase()}` : p.name}
        />
      <span class="category-badge">{categories[p.category].label}</span>
      {reference && <span class="reference-badge">{copy.ui.referenceImage}</span>}
      <span class="product-plus" aria-hidden="true">
        +
      </span>
    </div>
    <h3>{productTitle(p.name)}</h3>
    {prices.length > 0 && (
      <p class="product-price">
        {prices.length > 1 && Math.min(...prices) !== Math.max(...prices) ? "Desde " : ""}
        {formatPrice(Math.min(...prices))}
      </p>
    )}
    <div class="product-bottom">
      <span>
        {[...new Set(variants.map((v) => v.capacity ?? "Por confirmar"))]
          .slice(0, 3)
          .join(" / ")}
      </span>
      <span>{copy.ui.descubrir}</span>
    </div>
  </a>
  <template class="dialog-photo">
    <Photo
        src={src}
        kind="dialog"
        alt={reference ? `${p.name}: ${reference.toLowerCase()}` : p.name}
      />
    {reference && <p class="image-note">{reference}</p>}
  </template>
</article>
